# Copier vers .env.production sur le VPS (ne jamais committer les secrets)
# cp .env.production.example .env.production

POSTGRES_USER=leafitome
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort
POSTGRES_DB=leafitome

JWT_SECRET=change-moi-une-longue-chaine-aleatoire
CORS_ORIGIN=https://leafitome.prumme.dev
COOKIE_SECURE=true

# Web Push — générer sur le VPS : npx web-push generate-vapid-keys
# (ne pas réutiliser les clés de dev)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@prumme.dev

# Dashboard /admin (session 2h)
ADMIN_PASSWORD=change-moi-admin-fort
