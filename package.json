{
  "name": "leafitome",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:web": "npm run dev -w @leafitome/web",
    "dev:api": "npm run dev -w @leafitome/api",
    "build": "npm run build -w @leafitome/api && npm run build -w @leafitome/web",
    "build:web": "npm run build -w @leafitome/web",
    "build:api": "npm run build -w @leafitome/api",
    "lint": "npm run lint -w @leafitome/web --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate -w @leafitome/api",
    "icons": "npm run icons -w @leafitome/web",
    "prod:up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f"
  }
}
